# Use the port assigned to your lab application (the guide lists 8081 and 8082).
APP_BASE_URL=http://127.0.0.1:8081

# Use a dedicated test agent account supplied by your mentor/lab.
E2E_USERNAME=
E2E_PASSWORD=
E2E_API_KEY=
E2E_API_AGENT_EMAIL=

# Optional, isolated accounts/test records for lockout, empty-state, and API scenarios.
E2E_LOCKED_USERNAME=
E2E_LOCKED_PASSWORD=
E2E_LOCKOUT_USERNAME=
E2E_NEW_AGENT_USERNAME=
E2E_NEW_AGENT_PASSWORD=
E2E_APPLICATION_ID=
E2E_SUBMITTED_APPLICATION_ID=
E2E_AGE_INELIGIBLE_APPLICATION_ID=
API_BASE_URL=http://127.0.0.1:8081

# Enable only with a disposable test-agent account; the workflow creates synthetic application data.
E2E_FULL_SUBMISSION=false
